<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>es</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>es</string>
		<string>en</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>AstroQuest</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The launcher window first; the game opens a full immersive space from it. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationPreferredDefaultSceneSessionRole</key>
		<string>UIWindowSceneSessionRoleApplication</string>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<!-- StikDebug is asked for JIT through its URL scheme. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>stikjit</string>
		<string>stikdebug</string>
	</array>
	<!-- The game's folder is copied into the app's Documents with the Files app. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- The controller: PlayStation's, through the GameController framework. -->
	<key>GCSupportsControllerUserInteraction</key>
	<true/>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
		<dict>
			<key>ProfileName</key>
			<string>SpatialGamepad</string>
		</dict>
	</array>
	<key>NSAccessoryTrackingUsageDescription</key>
	<string>El visor sigue los mandos PlayStation VR2 Sense para colocar el mando dentro del juego.</string>
	<key>NSHandsTrackingUsageDescription</key>
	<string>Las manos que sujetan el mando colocan el mando dentro del juego, como hacía la cámara de PlayStation VR.</string>
	<key>NSWorldSensingUsageDescription</key>
	<string>El seguimiento de la cabeza sitúa al jugador en el juego.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Los mandos de PlayStation se conectan por Bluetooth.</string>
	<key>NSCameraUsageDescription</key>
	<string>AstroQuest no usa la cámara: la cámara de PlayStation se simula con el seguimiento del visor.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>El juego escucha el micrófono para soplar a las cosas, como con el micrófono de PlayStation VR.</string>
</dict>
</plist>
