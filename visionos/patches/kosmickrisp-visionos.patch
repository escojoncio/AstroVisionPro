+/* Encoder census (KK_CENSUS=1). */
+bool
+kk_census(void)
+{
+   static int enabled = -1;
+   if (enabled < 0) {
+      const char *env = getenv("KK_CENSUS");
+      enabled = env && env[0] == '1';
+   }
+   return enabled;
+}
+
+#define KK_CENSUS_SITES 48u
+static struct {
+   simple_mtx_t lock;
+   int64_t since;
+   uint32_t render;
+   uint32_t compute;
+   uint32_t passes;
+   struct {
+      const char *site;
+      uint32_t cuts;
+      uint32_t computes;
+   } sites[KK_CENSUS_SITES];
+   uint32_t num_sites;
+} census = {.lock = SIMPLE_MTX_INITIALIZER};
+
+static const char *
+census_short(const char *site)
+{
+   const char *slash = strrchr(site, '/');
+   return slash ? slash + 1 : site;
+}
+
+/* With census.lock held. */
+static void
+census_report(int64_t now)
+{
+   if (census.since == 0) {
+      census.since = now;
+      return;
+   }
+   const double seconds = (double)(now - census.since) / 1e9;
+   if (seconds < 5.0)
+      return;
+   char text[2048];
+   size_t used = 0;
+   for (uint32_t i = 0; i < census.num_sites && used < sizeof(text) - 96; ++i) {
+      if (census.sites[i].cuts == 0 && census.sites[i].computes == 0)
+         continue;
+      used += snprintf(text + used, sizeof(text) - used, "%s%s %.1f cut %.1f compute",
+                       used ? "; " : "", census_short(census.sites[i].site),
+                       census.sites[i].cuts / seconds, census.sites[i].computes / seconds);
+      census.sites[i].cuts = 0;
+      census.sites[i].computes = 0;
+   }
+   text[used] = '\0';
+   fprintf(stderr,
+           "KK_CENSUS: a second, %.0f render encoders for %.0f Vulkan render passes, "
+           "%.0f compute encoders; where render encoders were cut and compute encoders "
+           "made: %s\n",
+           census.render / seconds, census.passes / seconds, census.compute / seconds,
+           used ? text : "nowhere");
+   census.render = census.compute = census.passes = 0;
+   census.since = now;
+}
+
+void
+kk_census_note(const char *site, bool cut)
+{
+   if (!kk_census())
+      return;
+   simple_mtx_lock(&census.lock);
+   uint32_t i = 0;
+   while (i < census.num_sites && census.sites[i].site != site)
+      ++i;
+   if (i == census.num_sites && census.num_sites < KK_CENSUS_SITES)
+      census.sites[census.num_sites++].site = site;
+   if (i < census.num_sites) {
+      if (cut)
+         census.sites[i].cuts++;
+      else
+         census.sites[i].computes++;
+   }
+   if (!cut)
+      census.compute++;
+   simple_mtx_unlock(&census.lock);
+}
+
+static void
+census_note_encoder(bool render, bool vulkan_pass)
+{
+   if (!kk_census())
+      return;
+   simple_mtx_lock(&census.lock);
+   if (render)
+      census.render++;
+   if (vulkan_pass)
+      census.passes++;
+   census_report(os_time_get_nano());
+   simple_mtx_unlock(&census.lock);
+}
+
+void
+kk_census_note_pass(void)
+{
+   census_note_encoder(false, true);
+}
