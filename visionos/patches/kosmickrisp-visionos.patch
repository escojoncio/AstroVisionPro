+
+static char *
+kk_kernel_as_vertex(const char *code, const char **reason)
+{
+   static const char *const blocked[] = {
+      "threadgroup", "simd", "quad_", "gl_LocalInvocation", "gl_WorkGroupID",
+      "gl_NumWorkGroups", "gl_SubGroup", "gl_NumSubGroups", "atomic",
+   };
+   for (unsigned i = 0; i < ARRAY_SIZE(blocked); ++i) {
+      if (strstr(code, blocked[i])) {
+         *reason = blocked[i];
+         return NULL;
+      }
+   }
+
+   static const char kernel[] = "kernel void ";
+   static const char gid[] =
+      "uint3 gl_GlobalInvocationID [[thread_position_in_grid]]";
+   static const char ids[] = "uint kk_vertex_id [[vertex_id]],\n"
+                             "   uint kk_instance_id [[instance_id]]";
+   static const char def[] = "   uint3 gl_GlobalInvocationID = "
+                             "uint3(kk_vertex_id, kk_instance_id, 0u);\n";
+
+   const char *k = strstr(code, kernel);
+   if (!k || strstr(k + 1, kernel)) {
+      *reason = "entry point";
+      return NULL;
+   }
+   const char *body = strstr(k, ")\n{\n");
+   if (!body) {
+      *reason = "signature";
+      return NULL;
+   }
+   body += 4;
+   const char *g = strstr(k, gid);
+   if (g && g > body)
+      g = NULL;
+
+   size_t len = strlen(code) + sizeof(ids) + sizeof(def) + 16;
+   char *out = malloc(len);
+   if (!out) {
+      *reason = "memory";
+      return NULL;
+   }
+   char *o = out;
+   memcpy(o, code, k - code);
+   o += k - code;
+   o += sprintf(o, "vertex void ");
+   const char *rest = k + strlen(kernel);
+   if (g) {
+      memcpy(o, rest, g - rest);
+      o += g - rest;
+      memcpy(o, ids, strlen(ids));
+      o += strlen(ids);
+      rest = g + strlen(gid);
+   }
+   memcpy(o, rest, body - rest);
+   o += body - rest;
+   if (g) {
+      memcpy(o, def, strlen(def));
+      o += strlen(def);
+   }
+   strcpy(o, body);
+   return out;
+}
+
+static mtl_render_pipeline_state *
+kk_compile_vertex_only_pipeline(struct kk_device *device,
+                                const struct msl_compile_data *data,
+                                const struct kk_shader_info *info)
+{
+   struct kk_physical_device *pdev = kk_device_physical(device);
+   static uint32_t reports = 0u;
+
+   const char *reason = NULL;
+   char *code = kk_kernel_as_vertex(data->code, &reason);
+   if (!code) {
+      if (reports++ < 16u)
+         fprintf(stderr, "KK_GS_IN_PASS: %s stays a compute pass (%s)\n",
+                 data->entrypoint_name, reason);
+      return NULL;
+   }
+
+   mtl_library *library = mtl_new_library(
+      device->mtl_compiler_handle, code, pdev->info.msl_version,
+      MTL_MATH_MODE_FAST, MTL_MATH_FLOATING_POINT_FUNCTIONS_FAST);
+   free(code);
+   if (library == NULL) {
+      if (reports++ < 16u)
+         fprintf(stderr, "KK_GS_IN_PASS: %s did not compile as a vertex "
+                         "function\n", data->entrypoint_name);
+      return NULL;
+   }
+
+   mtl_function_descriptor *function =
+      mtl_new_library_function_descriptor(library, data->entrypoint_name);
+   mtl_render_pipeline_descriptor *descriptor =
+      mtl_new_render_pipeline_descriptor();
+   mtl_render_pipeline_descriptor_set_vertex_shader(descriptor, function);
+   mtl_render_pipeline_descriptor_set_rasterization_enabled(descriptor, false);
+   mtl_render_pipeline_descriptor_set_input_primitive_topology(
+      descriptor, MTL_PRIMITIVE_TOPOLOGY_CLASS_POINT);
+   for (uint8_t i = 0; i < MAX_DRAW_BUFFERS; ++i) {
+      if (info->vs.rt_formats[i] != MTL_PIXEL_FORMAT_INVALID)
+         mtl_render_pipeline_descriptor_set_color_attachment_format(
+            descriptor, i, info->vs.rt_formats[i]);
+   }
+   if (info->vs.has_ms)
+      mtl_render_pipeline_descriptor_set_raster_sample_count(
+         descriptor, info->vs.sample_count);
+
+   mtl_render_pipeline_state *pipeline =
+      mtl_new_render_pipeline(device->mtl_compiler_handle, descriptor);
+   mtl_release(descriptor);
+   mtl_release(function);
+   mtl_release(library);
+
+   if (pipeline == NULL && reports++ < 16u)
+      fprintf(stderr, "KK_GS_IN_PASS: no vertex-only pipeline for %s\n",
+              data->entrypoint_name);
+   return pipeline;
+}
