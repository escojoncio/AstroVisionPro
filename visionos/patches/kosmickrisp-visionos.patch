diff --git a/src/kosmickrisp/bridge/mtl_device.m b/src/kosmickrisp/bridge/mtl_device.m
index dc580ed..adb6aae 100644
--- a/src/kosmickrisp/bridge/mtl_device.m
+++ b/src/kosmickrisp/bridge/mtl_device.m
@@ -13,6 +13,7 @@
 #include <Metal/MTL4Counters.h>
 #include <Metal/MTLCaptureManager.h>
 #include <Metal/MTLDevice.h>
+#include <TargetConditionals.h>
 
 /* Device creation */
 mtl_device *
@@ -21,6 +22,7 @@ mtl_device_create()
    mtl_device *device = nil;
 
    @autoreleasepool {
+#if TARGET_OS_OSX
       NSArray<id<MTLDevice>> *devs = [MTLCopyAllDevices() autorelease];
       uint32_t device_count = [devs count];
       
@@ -30,6 +32,15 @@ mtl_device_create()
             break;
          }
       }
+#else
+      /* iOS, visionOS: one GPU, the system's (MTLCopyAllDevices is macOS only).
+       * MTLCreateSystemDefaultDevice returns a +1 reference. */
+      id<MTLDevice> dev = MTLCreateSystemDefaultDevice();
+      if (dev != nil && [dev supportsFamily:MTLGPUFamilyMetal4])
+         device = (mtl_device *)dev;
+      else if (dev != nil)
+         [dev release];
+#endif
    }
 
    return device;
diff --git a/src/kosmickrisp/vulkan/kk_bo.c b/src/kosmickrisp/vulkan/kk_bo.c
