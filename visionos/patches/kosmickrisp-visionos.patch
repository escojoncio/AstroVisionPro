+      p_atomic_add(&tally_bytes[bo->tally_kind], -(int64_t)bo->size_B);
+      p_atomic_add(&tally_count[bo->tally_kind], -1);
+   }
+   bo->tally_kind = kind;
+   p_atomic_add(&tally_bytes[kind], (int64_t)bo->size_B);
+   p_atomic_add(&tally_count[kind], 1);
+}
