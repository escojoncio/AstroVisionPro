+static void
+kk_bo_tally(uint8_t kind, int64_t bytes, int64_t count)
+{
+   if (kind == 0 || kind >= KK_BO_KIND_COUNT)
+      return;
+   p_atomic_add(&tally_bytes[kind], bytes);
+   p_atomic_add(&tally_count[kind], count);
+   int64_t total = 0;
+   for (unsigned k = 1; k < KK_BO_KIND_COUNT; ++k)
+      total += p_atomic_read(&tally_bytes[k]);
+   int64_t reported = p_atomic_read(&tally_reported);
+   if (total - reported >= (64ll << 20) || reported - total >= (64ll << 20)) {
+      p_atomic_set(&tally_reported, total);
+      fprintf(stderr,
+              "KK_MEMORY: %lld MB in all; Vulkan memory %lld MB in %lld, descriptor "
+              "pools %lld MB in %lld, the driver's own %lld MB in %lld\n",
+              (long long)(total >> 20),
+              (long long)(p_atomic_read(&tally_bytes[KK_BO_KIND_VULKAN_MEMORY]) >> 20),
+              (long long)p_atomic_read(&tally_count[KK_BO_KIND_VULKAN_MEMORY]),
+              (long long)(p_atomic_read(&tally_bytes[KK_BO_KIND_DESCRIPTOR_POOL]) >> 20),
+              (long long)p_atomic_read(&tally_count[KK_BO_KIND_DESCRIPTOR_POOL]),
+              (long long)(p_atomic_read(&tally_bytes[KK_BO_KIND_OTHER]) >> 20),
+              (long long)p_atomic_read(&tally_count[KK_BO_KIND_OTHER]));
+   }
+}
+
+void
+kk_bo_note_kind(struct kk_bo *bo, enum kk_bo_kind kind)
+{
