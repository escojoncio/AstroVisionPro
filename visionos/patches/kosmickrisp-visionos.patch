diff --git a/src/kosmickrisp/vulkan/kk_image.c b/src/kosmickrisp/vulkan/kk_image.c
index 5cbf34b..aea51d4 100644
--- a/src/kosmickrisp/vulkan/kk_image.c
+++ b/src/kosmickrisp/vulkan/kk_image.c
@@ -11,6 +11,7 @@
 #include "kk_device_memory.h"
 #include "kk_entrypoints.h"
 #include "kk_format.h"
+#include "kk_image_view.h"
 #include "kk_physical_device.h"
 
 #include "kosmickrisp/bridge/mtl_bridge.h"
@@ -1192,3 +1193,47 @@ kk_image_set_label(struct kk_image *image, const char *label)
          mtl_resource_set_label(image->planes[i].mtl_handle_array, label);
    }
 }
+
+#ifdef VK_USE_PLATFORM_METAL_EXT
+/* VK_EXT_metal_objects, as far as an application that shows images with Metal itself needs it:
+ * the Metal device, and the Metal texture behind a bound image (or image view). Not reference
+ * counted: the objects stay valid for as long as the Vulkan ones they come from. */
+VKAPI_ATTR void VKAPI_CALL
+kk_ExportMetalObjectsEXT(VkDevice _device,
+                         VkExportMetalObjectsInfoEXT *pMetalObjectsInfo)
+{
+   VK_FROM_HANDLE(kk_device, dev, _device);
+
+   vk_foreach_struct(sType, ext, (void *)pMetalObjectsInfo->pNext) {
+      switch (sType) {
+      case VK_STRUCTURE_TYPE_EXPORT_METAL_DEVICE_INFO_EXT: {
+         VkExportMetalDeviceInfoEXT *info = (VkExportMetalDeviceInfoEXT *)ext;
+         info->mtlDevice = (MTLDevice_id)dev->mtl_handle;
+         break;
+      }
+      case VK_STRUCTURE_TYPE_EXPORT_METAL_TEXTURE_INFO_EXT: {
+         VkExportMetalTextureInfoEXT *info = (VkExportMetalTextureInfoEXT *)ext;
+         uint32_t plane = 0;
+         if (info->plane == VK_IMAGE_ASPECT_PLANE_1_BIT)
+            plane = 1;
+         else if (info->plane == VK_IMAGE_ASPECT_PLANE_2_BIT)
+            plane = 2;
+         if (info->image != VK_NULL_HANDLE) {
+            VK_FROM_HANDLE(kk_image, image, info->image);
+            info->mtlTexture = plane < image->plane_count
+               ? (MTLTexture_id)image->planes[plane].mtl_handle : NULL;
+         } else if (info->imageView != VK_NULL_HANDLE) {
+            VK_FROM_HANDLE(kk_image_view, view, info->imageView);
+            info->mtlTexture = plane < view->plane_count
+               ? (MTLTexture_id)view->planes[plane].mtl_handle_sampled : NULL;
+         } else {
+            info->mtlTexture = NULL;
+         }
+         break;
+      }
+      default:
+         break;
+      }
+   }
+}
+#endif
