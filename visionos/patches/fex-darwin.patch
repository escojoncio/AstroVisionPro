new file mode 100644
index 0000000..1969a7a
--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/DarwinCompat.h
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+// What FEXCore needs on Apple systems (iOS, visionOS, macOS) in place of the Linux interfaces it
+// otherwise uses: futexes, thread ids, and a place to write code into memory that is only ever
+// mapped either writable or executable.
+
+#ifdef __APPLE__
+#include <os/os_sync_wait_on_address.h>
+#include <pthread.h>
+
+#include <atomic>
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <ctime>
+
+namespace FEXCore::Darwin {
+
+/// Sleeps while the 32-bit word at `Address` holds `Expected` (or until woken, or the timeout
+/// passed). Returns -1 with errno ETIMEDOUT when the timeout passed.
+inline int FutexWait(void* Address, uint32_t Expected, const struct timespec* Timeout = nullptr) {
+  if (Timeout != nullptr) {
+    const uint64_t Nanoseconds = static_cast<uint64_t>(Timeout->tv_sec) * 1'000'000'000ULL + static_cast<uint64_t>(Timeout->tv_nsec);
+    return os_sync_wait_on_address_with_timeout(Address, Expected, sizeof(uint32_t), OS_SYNC_WAIT_ON_ADDRESS_NONE,
+                                                OS_CLOCK_MACH_ABSOLUTE_TIME, Nanoseconds);
+  }
+  return os_sync_wait_on_address(Address, Expected, sizeof(uint32_t), OS_SYNC_WAIT_ON_ADDRESS_NONE);
+}
+
+inline void FutexWakeOne(void* Address) {
+  os_sync_wake_by_address_any(Address, sizeof(uint32_t), OS_SYNC_WAKE_BY_ADDRESS_NONE);
+}
+
+inline void FutexWakeAll(void* Address) {
+  os_sync_wake_by_address_all(Address, sizeof(uint32_t), OS_SYNC_WAKE_BY_ADDRESS_NONE);
+}
+
+inline int32_t ThreadId() {
+  uint64_t Id {};
+  pthread_threadid_np(nullptr, &Id);
+  return static_cast<int32_t>(Id);
+}
+
+/// The system only hands out memory that can be executed once, as two mappings of the same pages:
+/// code runs at one address and is written at another (see the embedding application). The
+/// embedder tells FEXCore where that memory is before it creates a context; FEXCore takes its
+/// code buffers from it, and writes to them through `Writable`.
+struct ExecutableMemory {
+  /// Hands out `Size` bytes of executable memory, page aligned, or null.
+  void* (*Allocate)(size_t Size) {};
+  /// Gives it back.
+  void (*Free)(void* Executable) {};
+  /// Where the executable mapping is, and how far the writable one is from it.
+  uintptr_t Begin {};
+  uintptr_t End {};
+  intptr_t WriteOffset {};
+};
+
+inline ExecutableMemory& GetExecutableMemory() {
+  static ExecutableMemory Memory {};
+  return Memory;
+}
+
+inline void SetExecutableMemory(const ExecutableMemory& Memory) {
+  GetExecutableMemory() = Memory;
+}
+
+/// The address to write to for the executable address `Address` (itself, outside of it).
+template<typename T>
+inline T* Writable(T* Address) {
+  const auto& Memory = GetExecutableMemory();
+  const auto Value = reinterpret_cast<uintptr_t>(Address);
+  if (Value >= Memory.Begin && Value < Memory.End) {
+    return reinterpret_cast<T*>(Value + Memory.WriteOffset);
+  }
+  return Address;
+}
+
+} // namespace FEXCore::Darwin
+
+#define FEX_JIT_WRITABLE(Address) ::FEXCore::Darwin::Writable(Address)
+#else
+#define FEX_JIT_WRITABLE(Address) (Address)
+#endif
